{
  "name": "@rctf/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun --no-orphans vite dev",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "prepare": "bunx --bun svelte-kit sync || echo ''",
    "check": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "bun run check",
    "test": "bun test tests"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@lezer/highlight": "1.2.3",
    "@rctf/types": "workspace:*",
    "@rctf/util": "workspace:*",
    "@replit/codemirror-indentation-markers": "6.5.3",
    "@tanstack/svelte-query": "6.1.38",
    "@tanstack/virtual-core": "3.17.7",
    "@zag-js/accordion": "1.43.1",
    "@zag-js/avatar": "1.43.1",
    "@zag-js/combobox": "1.43.1",
    "@zag-js/dialog": "1.43.1",
    "@zag-js/menu": "1.43.1",
    "@zag-js/progress": "1.43.1",
    "@zag-js/splitter": "1.43.1",
    "@zag-js/svelte": "1.43.1",
    "@zag-js/tabs": "1.43.1",
    "@zag-js/toast": "1.43.1",
    "@zag-js/tooltip": "1.43.1",
    "@zag-js/tree-view": "1.43.1",
    "dompurify": "3.4.13",
    "marked": "18.0.9",
    "modern-screenshot": "4.7.0",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/bun": "catalog:",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
