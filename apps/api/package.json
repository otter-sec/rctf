{
  "name": "@rctf/api",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd ../../; bun --watch --no-orphans apps/api/src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun run ./build.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1079.0",
    "@aws-sdk/client-ses": "3.1079.0",
    "@fastify/proxy-addr": "5.1.0",
    "@google-cloud/storage": "7.21.0",
    "@kubernetes/client-node": "1.4.0",
    "@rctf/config": "workspace:*",
    "@rctf/db": "workspace:*",
    "@rctf/scoring": "workspace:*",
    "@rctf/types": "workspace:*",
    "@rctf/util": "workspace:*",
    "data-uri-to-buffer": "8.0.0",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "hono-pino": "0.10.3",
    "ioredis": "5.11.1",
    "mustache": "catalog:",
    "nodemailer": "9.0.3",
    "openai": "6.45.0",
    "pino": "catalog:",
    "postgres": "catalog:",
    "sharp": "0.35.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rctf/build": "workspace:*",
